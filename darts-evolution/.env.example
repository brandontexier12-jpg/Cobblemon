# DARTS EVOLUTION — copiez ce fichier en « .env » et adaptez les valeurs.
# Ne mettez jamais ce fichier .env dans Git : il peut contenir le mot de passe administrateur.

# Port d'accès depuis le réseau local (http://IP_DU_NAS:8080). Le conteneur écoute toujours sur 8080.
APP_PORT=8080

# Fuseau horaire (statistiques par jour / semaine / mois).
TZ=Europe/Paris

# Propriétaire des fichiers créés dans ./data et ./backups (identifiants de votre utilisateur NAS : commande « id »).
PUID=1000
PGID=1000

# Mot de passe administrateur : protège sauvegardes, restauration, exports complets et configuration Autodarts.
# Fortement recommandé. Laissé vide, ces actions sont ouvertes à tout appareil du réseau local.
ADMIN_PASSWORD=

# Sauvegardes automatiques (en heures, 0 = désactivées) et nombre de sauvegardes automatiques conservées.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14

# Intégration Autodarts : adresse de la machine qui exécute le Board Manager Autodarts (pas « localhost »
# si elle est différente du NAS). Port 3180 par défaut. Aucune clé ni identifiant de compte n'est nécessaire.
# Ces valeurs sont des valeurs initiales : la page « Intégration Autodarts » permet ensuite de les modifier.
AUTODARTS_ENABLED=false
AUTODARTS_HOST=
AUTODARTS_PORT=3180
AUTODARTS_PROTOCOL=http

# Niveau de journalisation : error, warn, info, debug.
LOG_LEVEL=info

# Construction : exécuter les tests pendant la construction de l'image (true/false).
RUN_TESTS=true

# Chemins internes du conteneur (à ne modifier qu'en dehors de Docker) :
# DATABASE_PATH=/app/data/darts-evolution.db
# BACKUP_PATH=/app/backups
