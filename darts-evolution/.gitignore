node_modules/
dist/
coverage/
*.log
.env
.env.local
# Données d'exécution : jamais dans Git
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
tests/e2e/screenshots/
.vite/
# Données créées par « npm run dev:server » (lancé depuis apps/server)
apps/server/data/
apps/server/backups/

# Paquets de mise à jour produits par « npm run package »
dist-release/
# Dossier release/ présent dans un paquet décompressé (mise à jour manuelle)
/release/

# Application Windows : installateur produit par « npm run dist:win » (apps/desktop)
apps/desktop/release/
# Icônes de l'application Windows (le .gitignore du dépôt parent exclut les dossiers « build »)
!/apps/desktop/build/
